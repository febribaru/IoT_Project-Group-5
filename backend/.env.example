# =========================================================
# ELECTRONIC NOSE ROBUSTA - BACKEND ENVIRONMENT CONFIGURATION
# =========================================================

# Port Web Server & WebSocket (Default: 3000)
SERVER_PORT=3000

# Port Serial ESP32 Hardware (COM6 terdeteksi di Windows)
SERIAL_PORT=COM6
BAUD_RATE=115200

# Wi-Fi Hotspot Network Credentials
WIFI_SSID=POCO
WIFI_PASSWORD=12345678

# MQTT Broker (Untuk komunikasi data nirkabel)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=enose/robusta/telemetry

# Azure IoT Hub Credentials (MQTT TLS Port 8883)
AZURE_DEVICE_ID=enose-robusta-device-01
AZURE_DEVICE_CONNECTION_STRING=HostName=enose-robusta-hub123.azure-devices.net;DeviceId=enose-robusta-device-01;SharedAccessKey=YOUR_SHARED_ACCESS_KEY_HERE
AZURE_IOT_HUB_CONNECTION_STRING=
AZURE_STORAGE_CONNECTION_STRING=
